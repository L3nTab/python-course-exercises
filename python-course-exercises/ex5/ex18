arvud = [7, 12, 19, 24, 31, 46, 53, 60, 72]
paarissumma = 0
paaritsumma = 0
paariskogus = 0
paaritkogus = 0

i = 0
while i < len(arvud):
    if arvud[i] % 2 == 0:
        paariskogus += 1
        paarissumma += arvud[i]
    else:
        paaritkogus += 1
        paaritsumma += arvud[i]
    i += 1

print(f"Paaris numbreid: {paariskogus}, summa: {paarissumma}")
print(f"Paarituid numbreid: {paaritkogus}, summa: {paaritsumma}")