with open("opilased.txt", "w", encoding="utf-8") as fail:
    fail.write("Mari 5 4 5 3\nJüri 3 4\nAnna 5 5 4 5 5\nPeeter 2 3 3\nKati 4 5 5 4 5 5\nMartin 3 4 4")

parim_nimi = ""
parim_keskmine = -1

with open("opilased.txt", "r", encoding="utf-8") as fail:
    for rida in fail:
        if rida.strip():
            osad = rida.split()
            nimi = osad[0]
            hinned = [int(h) for h in osad[1:]]
            kogus = len(hinned)
            keskmine = sum(hinned) / kogus
            print(f"Õpilane: {nimi}, Hindeid: {kogus}, Keskmine: {keskmine:.2f}")
            if keskmine > parim_keskmine:
                parim_keskmine = keskmine
                parim_nimi = nimi

print(f"\nParimate tulemustega õpilane: {parim_nimi} (keskmine: {parim_keskmine:.2f})")