with open("arvud.txt", "r", encoding="utf-8") as fail:
    arvud = [int(rida.strip()) for rida in fail if rida.strip()]

paariskarvud = [arv for arv in arvud if arv % 2 == 0]

with open("paarisarvud.txt", "w", encoding="utf-8") as fail:
    for arv in paariskarvud:
        fail.write(f"{arv}\n")

print("Paarisarvud on salvestatud faili paarisarvud.txt.")